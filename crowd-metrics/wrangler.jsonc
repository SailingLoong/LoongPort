{
	// crowd-metrics：中转站实测数据的聚合 Worker。
	//
	// 端点：POST /v1/ingest（客户端上传小时聚合桶）、GET /v1/snapshot（公共快照，CORS *）、
	// POST /v1/feedback（问题反馈：附件入 R2 → 私有仓 GitHub issue）、
	// GET /v1/feedback-asset/<key>（按不可猜 key 读回附件，issue 正文内嵌用）。
	// Cron 每 10 分钟从 D1 重算 k-匿名后的快照（snapshot+trend 两键）写入 KV；原始桶保留 30 天。
	// 周期对齐 GET 自愈的 10 分钟新鲜窗（freshness.ts）；再放宽会把重算推到请求路径，
	// 收紧则白烧 KV 免费写入配额（每 5 分钟 × 2 键 = 576 写/天，会触发免费档 50% 告警）。
	//
	// ⚠️ 绑定名必须是 `DB` / `SNAPSHOT` / `FEEDBACK` —— Worker 代码（src/ingest.ts 的 Env）
	// 按这三个名字取资源；`wrangler d1/kv/r2 create` 交互式自动写入时会问绑定名，别让它另起一个
	// （否则配置里会出现两条指向同一资源的条目，deploy.sh 的占位闸也拦不住这种错）。
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "loongport-metrics",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "loongport-metrics",
			"database_id": "5b1950d0-319a-4e77-8159-50d3ff2d7111"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SNAPSHOT",
			"id": "f3c37850231641cda571c75c46c6c961"
		}
	],
	// r2 前置条件：部署前先 `npx wrangler r2 bucket create loongport-feedback`
	// （bucket 不存在时 deploy 会失败——这是期望的占位闸）。附件 90 天过期，scheduled 清理。
	"r2_buckets": [
		{
			"binding": "FEEDBACK",
			"bucket_name": "loongport-feedback"
		}
	],
	"routes": [
		{
			// workers.dev 在国内网络不可达（实测 SSL 重置），自定义域是主通路：
			// 客户端/网站常量都指向这里。custom_domain 让 wrangler 自动建 DNS + 绑定。
			"pattern": "metrics.loongport.dev",
			"custom_domain": true
		}
	],
	"triggers": {
		"crons": [
			"*/10 * * * *"
		]
	}
}
